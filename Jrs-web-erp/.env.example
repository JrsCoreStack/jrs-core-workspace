# =============================================================================
# JRS ERP Web (Next.js) — copie para .env.local e preencha.
# =============================================================================

# --- NextAuth (obrigatório em produção) ---------------------------------------
# Gere com: openssl rand -base64 32
AUTH_SECRET=1sWOSM2o-sk3weewmemio32SJKWQO9dsSwzW

# URL canônica do site em produção (ex.: https://seu-app.vercel.app).
# Ajuda callbacks e cookies em deploy.
AUTH_URL=http://localhost:3000

# --- API backend --------------------------------------------------------------
# Servidor (NextAuth, Server Components, rotas RSC): URL direta da API Nest.
# Se não definir, usa NEXT_PUBLIC_API_URL ou http://127.0.0.1:8081
API_URL=http://127.0.0.1:8081

# Cliente (browser): se definido, o axios chama essa URL direto (configure CORS na API).
# Em desenvolvimento sem esta variável, o front usa /api-proxy → API local (next.config).
# Em produção na Vercel, defina com a URL pública do backend (Railway), ex.:
# NEXT_PUBLIC_API_URL=https://sua-api.up.railway.app

# Alinha o proxy /api-proxy com a porta/host da API (dev). Padrão: 127.0.0.1:8081
 COCKPIT_API_ORIGIN=http://127.0.0.1:8081

# --- Telemetria cockpit (opcional) -------------------------------------------
# NEXT_PUBLIC_COCKPIT_TELEMETRY=1
# NEXT_PUBLIC_COCKPIT_TELEMETRY_URL=
# NEXT_PUBLIC_COCKPIT_TELEMETRY_4XX=1
