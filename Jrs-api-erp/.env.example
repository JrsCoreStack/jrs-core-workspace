# =============================================================================
# JRS ERP API — copie para .env ou .env.local e preencha os valores.
# =============================================================================

# --- Postgres (app principal) — use UMA das formas abaixo --------------------
# Opção A — recomendado no Neon / Railway: string única (não commite credenciais)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Opção B — variáveis separadas (local ou hosts sem URL única)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=jrs_erp
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Servidor HTTP ------------------------------------------------------------
PORT=8081

# Origem do frontend (CORS). Em produção: URL do app na Vercel (com https).
CORS_ORIGIN=http://localhost:3000

# --- JWT (obrigatório) --------------------------------------------------------
JWT_SECRET=defina_um_segredo_longo_e_aleatorio
JWT_EXPIRATION_TIME=7d

# --- Integração externa (opcional) -------------------------------------------
# URL da API legada / serviço externo usado em repasses (Producer Payout).
# EXTERNAL_API_URL=https://sua-api-externa.example.com

# --- Sales sync — banco do projeto integrado de vendas (opcional) ------------
# Conexão ao Postgres de onde o ERP lê vendas para sincronizar. Se vazio, o
# produto é ignorado (veja logs na subida da API).
# JRS_EXTERNAL_SALES_DB_HOST=
# JRS_EXTERNAL_SALES_DB_PORT=5432
# JRS_EXTERNAL_SALES_DB_USERNAME=
# JRS_EXTERNAL_SALES_DB_PASSWORD=
# JRS_EXTERNAL_SALES_DB_DATABASE=
# JRS_EXTERNAL_SALES_DB_SSL=true
